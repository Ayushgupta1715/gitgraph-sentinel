# FalkorDB Connection Settings
# Leave default for local Docker instance (docker run -p 6379:6379 -it --rm falkordb/falkordb)
# Or provide your free FalkorDB Cloud credentials from app.falkordb.cloud

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Optional Gemini API Key for autonomous natural language reasoning
GEMINI_API_KEY=
